#include <stdio.h>

int main() {

    int vetor[10];
    int maior;
    int posicao;

    for (int i = 0; i < 10; i++) {
        printf("Digite um valor: ");
        scanf("%d", &vetor[i]);
    }

    maior = vetor[0];
    posicao = 0;

    for (int i = 1; i < 10; i++) {

        if (vetor[i] > maior) {
            maior = vetor[i];
            posicao = i;
        }
    }

    printf("Vetor:\n");

    for (int i = 0; i < 10; i++) {
        printf("%d ", vetor[i]);
    }

    printf("\nMaior elemento: %d\n", maior);
    printf("Posicao: %d\n", posicao);

    return 0;
}
