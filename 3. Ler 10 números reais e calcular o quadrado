#include <stdio.h>

int main() {

    float vetor[10];
    float quadrado[10];

    for (int i = 0; i < 10; i++) {

        printf("Digite um numero: ");
        scanf("%f", &vetor[i]);

        quadrado[i] = vetor[i] * vetor[i];
    }

    printf("\nValores originais:\n");

    for (int i = 0; i < 10; i++) {
        printf("%.2f\n", vetor[i]);
    }

    printf("\nQuadrados:\n");

    for (int i = 0; i < 10; i++) {
        printf("%.2f\n", quadrado[i]);
    }

    return 0;
}
