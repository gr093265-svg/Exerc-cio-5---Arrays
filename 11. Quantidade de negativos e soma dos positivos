#include <stdio.h>

int main() {

    float vetor[10];
    int negativos = 0;
    float somaPositivos = 0;

    for (int i = 0; i < 10; i++) {

        printf("Digite um numero: ");
        scanf("%f", &vetor[i]);

        if (vetor[i] < 0) {
            negativos++;
        }

        if (vetor[i] > 0) {
            somaPositivos = somaPositivos + vetor[i];
        }
    }

    printf("Quantidade de negativos: %d\n", negativos);
    printf("Soma dos positivos: %.2f\n", somaPositivos);

    return 0;
}
